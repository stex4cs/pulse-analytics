# ─── Pulse — environment ────────────────────────────────────────────────────
NODE_ENV=production
TZ=UTC

# Sajtovi (multi-domain od starta — sekcija 15.7)
PULSE_SITES=rs,hr,ba,si
PULSE_DEFAULT_SITE=rs
PULSE_INTERNAL_DOMAINS=tvarenasport.com,tvarenasport.hr,tvarenasport.ba,tvarenasport.si

# Grupisanje teritorija na ingestion-u. MaxMind vraca XK za Kosovo; za ovog
# klijenta je ono deo Srbije, pa se broji pod RS. Isto grupisanje je primenjeno
# i na mapi. Prazna vrednost iskljucuje grupisanje.
PULSE_COUNTRY_MERGE="XK:RS"

# ─── ClickHouse ─────────────────────────────────────────────────────────────
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=pulse
CLICKHOUSE_USER=pulse
CLICKHOUSE_PASSWORD=change_me_clickhouse

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
PULSE_STREAM=pulse:events
PULSE_CONSUMER_GROUP=pulse-workers
PULSE_STREAM_MAXLEN=2000000

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change_me_postgres

# ─── Ingestion API ──────────────────────────────────────────────────────────
INGEST_PORT=8080
INGEST_RATE_LIMIT_PER_MIN=100
INGEST_MAX_EVENTS_PER_REQUEST=50
INGEST_SPOOL_DIR=/var/lib/pulse/spool
GEOIP_CITY_DB=/geoip/GeoLite2-City.mmdb
IP_HASH_SECRET=change_me_long_random_secret

# ─── Worker ─────────────────────────────────────────────────────────────────
WORKER_BATCH_SIZE=1000
WORKER_FLUSH_MS=5000
WORKER_CONSUMER_NAME=worker-1
WORKER_METRICS_PORT=9101

# ─── Cron / agregacije ──────────────────────────────────────────────────────
CRON_HOT_INTERVAL="*/5 * * * *"
CRON_NIGHTLY="15 2 * * *"
CRON_TRENDING="*/10 * * * *"
CRON_SPIKE="* * * * *"
CRON_METRICS_PORT=9102
SPIKE_MULTIPLIER=3
SPIKE_MIN_PAGEVIEWS_PER_MIN=50
SPIKE_COOLDOWN_MIN=20
SLACK_WEBHOOK_URL=

# ─── Dashboard API ──────────────────────────────────────────────────────────
API_PORT=8081
JWT_SECRET=change_me_jwt_secret_at_least_32_chars
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=30d
API_CORS_ORIGIN=http://localhost:3000

# ─── Dashboard (Next.js) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8081
DASHBOARD_PORT=3000

# ─── Email izveštaji ────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_FROM=pulse@tvarenasport.com
