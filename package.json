{
  "name": "pulse-analytics",
  "version": "1.0.0",
  "private": true,
  "description": "Pulse — custom analytics platforma za tvarenasport.com (Arena Channels Group)",
  "type": "module",
  "engines": { "node": ">=20" },
  "workspaces": [
    "packages/shared",
    "packages/ingest",
    "packages/worker",
    "packages/cron",
    "packages/api",
    "packages/dashboard",
    "sdk"
  ],
  "scripts": {
    "dev:ingest": "npm run dev -w @pulse/ingest",
    "dev:worker": "npm run dev -w @pulse/worker",
    "dev:cron": "npm run dev -w @pulse/cron",
    "dev:api": "npm run dev -w @pulse/api",
    "dev:dashboard": "npm run dev -w @pulse/dashboard",
    "build:sdk": "npm run build -w @pulse/sdk",
    "test": "node --test packages/shared/test/*.test.js packages/api/test/*.test.js",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "loadtest": "k6 run loadtest/k6-collect.js"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
